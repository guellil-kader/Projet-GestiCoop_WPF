<Window x:Class="GestiCoop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop - Gestion des stages coopératifs"
        Height="900" Width="1450" MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Fond}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border Grid.Column="0" Background="#263F73">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,25,18,28">
                    <TextBlock Text="GestiCoop" FontSize="25" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Gestion des stages coopératifs" FontSize="11"
                               Foreground="#CAD5ED" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MENU PRINCIPAL" Margin="20,0,0,10"
                               Foreground="#AABADD" FontSize="10" FontWeight="Bold"/>
                    <Button Content="⌂   Tableau de bord" Tag="dashboard" Click="Nav_Click"
                            Margin="10,2" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#E5EBF8"/>
                    <Button Content="▣   Offres de stage" Tag="offers" Click="Nav_Click"
                            Margin="10,2" HorizontalContentAlignment="Left" Background="#3A5790" Foreground="White"/>
                    <Button Content="▤   Entreprises" Tag="companies" Click="Nav_Click"
                            Margin="10,2" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#E5EBF8"/>
                    <Button Content="♙   Étudiants" Tag="students" Click="Nav_Click"
                            Margin="10,2" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#E5EBF8"/>
                    <Button Content="✓   Candidatures" Tag="applications" Click="Nav_Click"
                            Margin="10,2" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#E5EBF8"/>
                    <Button Content="⚙   Paramètres" Tag="settings" Click="Nav_Click"
                            Margin="10,2" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#E5EBF8"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,15,24">
                    <TextBlock Text="CONNECTÉ EN TANT QUE" Foreground="#AABADD" FontSize="9"/>
                    <TextBlock Text="Administrateur" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Column="1" Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="GestiCoop  /  Offres de stage" Foreground="{StaticResource Gris}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="●  SYSTÈME ACTIF" Foreground="#24845A" FontSize="11"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <TextBlock Text="Administrateur" Foreground="{StaticResource Texte}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,12,0,18">
                <TextBlock Text="Offres de stage" FontSize="28" FontWeight="Bold" Foreground="#202B43"/>
                <TextBlock Text="Publiez une nouvelle offre et gérez les offres existantes."
                           Foreground="{StaticResource Gris}" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Formulaire de publication -->
                    <Border Background="White" CornerRadius="9" BorderBrush="{StaticResource Bordure}"
                            BorderThickness="1" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <TextBlock Text="▣" Foreground="{StaticResource Bleu}" FontSize="18" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Nouvelle offre de stage" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Texte}"/>
                                    <TextBlock Text="Complétez les informations pour publier une offre."
                                               Foreground="{StaticResource Gris}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.25*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,13">
                                    <TextBlock Text="Entreprise *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CboEntreprise" IsEditable="True" Text="Sélectionner une entreprise">
                                        <ComboBoxItem Content="TechNova"/>
                                        <ComboBoxItem Content="Groupe Atlas"/>
                                        <ComboBoxItem Content="Solutions Boréal"/>
                                        <ComboBoxItem Content="Innovation Québec"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,13">
                                    <TextBlock Text="Programme / niveau *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CboProgramme" IsEditable="True" Text="Sélectionner un programme">
                                        <ComboBoxItem Content="Développement logiciel"/>
                                        <ComboBoxItem Content="Réseaux et cybersécurité"/>
                                        <ComboBoxItem Content="Analyse de données"/>
                                        <ComboBoxItem Content="Techniques informatiques"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,13">
                                    <TextBlock Text="Type de stage *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CboType">
                                        <ComboBoxItem Content="Stage coopératif" IsSelected="True"/>
                                        <ComboBoxItem Content="Stage d'été"/>
                                        <ComboBoxItem Content="Stage rémunéré"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,13">
                                    <TextBlock Text="Titre du poste *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtTitre" ToolTip="Ex. : Développeur junior"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,13">
                                    <TextBlock Text="Lieu de travail *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtLieu" Text="Ottawa, ON"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,13">
                                    <TextBlock Text="Salaire horaire ($)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtSalaire" Text="20.00"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,13">
                                    <TextBlock Text="Date de début *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="DateDebut"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,14,13">
                                    <TextBlock Text="Date de fin *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="DateFin"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,13">
                                    <TextBlock Text="Date limite *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="DateLimite"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Nombre de postes" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtPostes" Text="1"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="Description du stage *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Texte}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtDescription" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Padding="9" />
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,18,0,0">
                                <TextBlock x:Name="LblMessage" Text="Les champs marqués * sont obligatoires."
                                           Foreground="{StaticResource Gris}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Réinitialiser" Click="Reset_Click" Background="#EEF1F6" Foreground="#43516A" Margin="0,0,10,0"/>
                                    <Button Content="✓  Publier l'offre" Click="Publish_Click" Background="{StaticResource Bleu}" Foreground="White"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tableau des offres -->
                    <Border Background="White" CornerRadius="9" BorderBrush="{StaticResource Bordure}" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="▤  Liste des offres de stage" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Texte}"/>
                                    <TextBlock x:Name="LblNombre" Text="Offres publiées : 0" FontSize="12" Foreground="{StaticResource Gris}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBox x:Name="TxtRecherche" Width="220" ToolTip="Rechercher une offre" TextChanged="Search_TextChanged" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CboFiltre" Width="135" SelectionChanged="Filter_SelectionChanged">
                                        <ComboBoxItem Content="Tous les statuts" IsSelected="True"/>
                                        <ComboBoxItem Content="Ouverte"/>
                                        <ComboBoxItem Content="Fermée"/>
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="GridOffres" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeight="38" ColumnHeaderHeight="36" BorderBrush="#E1E6EF"
                                      AlternatingRowBackground="#F8FAFD" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ENTREPRISE" Binding="{Binding Entreprise}" Width="1.25*"/>
                                    <DataGridTextColumn Header="POSTE" Binding="{Binding Titre}" Width="1.5*"/>
                                    <DataGridTextColumn Header="PROGRAMME" Binding="{Binding Programme}" Width="1.25*"/>
                                    <DataGridTextColumn Header="LIEU" Binding="{Binding Lieu}" Width="*"/>
                                    <DataGridTextColumn Header="DÉBUT" Binding="{Binding Debut, StringFormat={}{0:yyyy-MM-dd}}" Width="105"/>
                                    <DataGridTextColumn Header="DATE LIMITE" Binding="{Binding Limite, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                                    <DataGridTextColumn Header="STATUT" Binding="{Binding Statut}" Width="85"/>
                                    <DataGridTemplateColumn Header="ACTION" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Modifier" Tag="{Binding}" Click="Edit_Click" Padding="7,4" Background="#EAF0FF" Foreground="#2455A8" Margin="0,0,5,0" FontSize="11"/>
                                                    <Button Content="Supprimer" Tag="{Binding}" Click="Delete_Click" Padding="7,4" Background="#FDECEC" Foreground="#B42318" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Astuce : utilisez la recherche ou le filtre pour retrouver rapidement une offre."
                                       FontSize="11" Foreground="{StaticResource Gris}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
